<!-- ----------------------------------------------------------------- -->
<!-- PAGINA CON CALENDARIO DEL CAMPIONATO SCELTO                       -->
<!--                            16.08.26                               -->
<!-- ----------------------------------------------------------------- -->
<%- include('partials/header.ejs') %>

    <main class="bg-light py-4 min-vh-100">
        <div class="container">
            <!-- HEADER CAMPIONATO -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="row align-items-center g-3">
                        <div class="col-auto">
                            <img src="<%= locals.competition.emblem %>" alt="<%= locals.competition.name %> logo"
                                style="max-height: 80px; width: auto;" class="img-fluid">
                        </div>
                        <div class="col">
                            <h1 class="h3 fw-bold mb-1">
                                <%= locals.competition.name %>
                            </h1>
                            <p class="text-muted mb-2">Stagione <%= locals.seasoncode.season %>
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <span
                                    class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                                    Partite totali: <%= locals.resultSet.count %>
                                </span>
                                <span
                                    class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                    Giocate: <%= locals.resultSet.played %>
                                </span>
                                <span
                                    class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill">
                                    <%= locals.resultSet.first %> &rarr; <%= locals.resultSet.last %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ACCORDION GIORNATE -->
            <div class="accordion shadow-sm rounded border-0" id="accordionCalendar">
                <% Object.keys(locals.groupedMatches).forEach((matchday, index)=> { %>
                    <div class="accordion-item border-0 border-bottom">
                        <h2 class="accordion-header" id="heading-<%= matchday %>">
                            <button class="accordion-button <%= index !== 0 ? 'collapsed' : '' %> fw-bold py-3 fs-5"
                                type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= matchday %>"
                                aria-expanded="<%= index === 0 ? 'true' : 'false' %>"
                                aria-controls="collapse-<%= matchday %>">
                                Giornata <%= matchday %>
                            </button>
                        </h2>
                        <div id="collapse-<%= matchday %>"
                            class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>"
                            aria-labelledby="heading-<%= matchday %>">
                            <div class="accordion-body bg-light p-3">

                                <!-- GRID MATCHES -->
                                <div class="row g-3">
                                    <% locals.groupedMatches[matchday].forEach(match=> { %>
                                        <div class="col-12 col-md-6 col-xl-4">
                                            <div class="card border-0 shadow-sm h-100">
                                                <div class="card-body d-flex flex-column justify-content-between p-3">

                                                    <div
                                                        class="text-center text-muted small fw-medium mb-2 pb-2 border-bottom">
                                                        <%= match.formattedDate %>
                                                    </div>

                                                    <div class="row align-items-center text-center my-2">
                                                        <div class="col-4 d-flex flex-column align-items-center">
                                                            <img src="<%= match.homeTeam.crest %>"
                                                                alt="<%= match.homeTeam.shortName %>"
                                                                style="height: 40px; width: 40px; object-fit: contain;"
                                                                class="mb-2">
                                                            <span class="fw-semibold small text-truncate w-100">
                                                                <%= match.homeTeam.shortName %>
                                                            </span>
                                                        </div>
                                                        <div class="col-4 px-0">
                                                            <% if (match.score && match.score.fullTime &&
                                                                match.score.fullTime.home !==null) { %>
                                                                <div class="fs-5 fw-bold bg-light py-1 rounded border">
                                                                    <%= match.score.fullTime.home %> - <%=
                                                                            match.score.fullTime.away %>
                                                                </div>
                                                                <% } else { %>
                                                                    <div class="badge bg-light text-dark border fs-6">VS
                                                                    </div>
                                                                    <% } %>
                                                        </div>
                                                        <div class="col-4 d-flex flex-column align-items-center">
                                                            <img src="<%= match.awayTeam.crest %>"
                                                                alt="<%= match.awayTeam.shortName %>"
                                                                style="height: 40px; width: 40px; object-fit: contain;"
                                                                class="mb-2">
                                                            <span class="fw-semibold small text-truncate w-100">
                                                                <%= match.awayTeam.shortName %>
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <div class="text-center mt-2 pt-2 border-top">
                                                        <% if (match.score.winner==='HOME_TEAM' ) { %>
                                                            <span class="badge bg-success-subtle text-success fw-normal">Vittoria Casa</span>
                                                        <% } else if (match.score.winner==='AWAY_TEAM' ) { %>
                                                                <span class="badge bg-success-subtle text-success fw-normal">Vittoria Ospiti</span>
                                                        <% } else if (match.score.winner==='DRAW' ) { %>
                                                                    <span class="badge bg-warning-subtle text-warning-emphasis fw-normal">Pareggio</span>
                                                        <% } else { %>
                                                            <span class="badge bg-secondary-subtle text-secondary fw-normal">Da Giocare</span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>

                            </div>
                        </div>
                    </div>
                    <% }); %>
            </div>

        </div>
    </main>

    <%- include('partials/footer.ejs') %>