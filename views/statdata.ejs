<%- include('partials/header') %>

<div class="container my-5">
    <!-- STATISTICHE STAGIONALI -->
    <div class="row g-3 mb-5">
        <div class="col-12">
            <h2 class="fw-bold text-dark-blue mb-4">Panoramica Stagione</h2>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-dark-blue text-white p-3 text-center h-100">
                <small class="text-uppercase opacity-75">Partite Totali</small>
                <h3 class="fw-bold mb-0 mt-auto"><%= locals.resultSet.count %></h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center border-start border-success border-5 h-100">
                <small class="text-uppercase text-muted">Vinte</small>
                <h3 class="fw-bold mb-0 text-success mt-auto"><%= locals.resultSet.wins %></h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center border-start border-warning border-5 h-100">
                <small class="text-uppercase text-muted">Pareggi</small>
                <h3 class="fw-bold mb-0 text-warning mt-auto"><%= locals.resultSet.draws %></h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center border-start border-danger border-5 h-100">
                <small class="text-uppercase text-muted">Perse</small>
                <h3 class="fw-bold mb-0 text-danger mt-auto"><%= locals.resultSet.losses %></h3>
            </div>
        </div>
    </div>

    <!-- LISTA RISULTATI E CALENDARIO -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold text-dark-blue mb-0">Risultati e Calendario</h3>
                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                    Giocate: <%= locals.resultSet.played %> / <%= locals.resultSet.count %>
                </span>
            </div>

            <div class="shadow-sm rounded-4 bg-white overflow-hidden">
                <% locals.matches.forEach(incontri => { 
                    const matchDate = new Date(incontri.utcDate);
                    const formattedDate = matchDate.toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit', year: 'numeric' });
                    const formattedTime = matchDate.toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' });
                %>
                    <div class="match-row row align-items-center p-3 border-bottom g-2 mx-0">
                        
                        <!-- GIORNATA & DATA -->
                        <div class="col-12 col-md-3 d-flex flex-column justify-content-center text-center text-md-start">
                            <span class="badge bg-light text-muted border w-auto align-self-center align-self-md-start mb-1">
                                Giornata <%= incontri.matchday %>
                            </span>
                            <small class="text-muted fw-semibold">
                                <i class="bi bi-calendar3 me-1"></i><%= formattedDate %> <% if (incontri.utcDate) { %>• <%= formattedTime %><% } %>
                            </small>
                        </div>       

                        <!-- SQUADRA CASA -->
                        <div class="col-4 col-md-3 d-flex align-items-center justify-content-end text-end">
                            <span class="fw-semibold me-2 text-truncate d-none d-sm-inline"><%= incontri.homeTeam.name %></span>
                            <img src="<%= incontri.homeTeam.crest %>" alt="<%= incontri.homeTeam.name %>" class="team-logo-small" style="width: 28px; height: 28px; object-fit: contain;">
                        </div>

                        <!-- PUNTEGGIO / VS -->
                        <div class="col-4 col-md-2 text-center">
                            <div class="match-score-box py-1 px-2 rounded bg-light fw-bold text-nowrap">
                                <% if (incontri.score.fullTime.home !== null) { %>
                                    <%= incontri.score.fullTime.home %> - <%= incontri.score.fullTime.away %>
                                <% } else { %>
                                    <small class="text-muted">VS</small>
                                <% } %>
                            </div>
                        </div>

                        <!-- SQUADRA OSPITE -->
                        <div class="col-4 col-md-2 d-flex align-items-center justify-content-start text-start">
                            <img src="<%= incontri.awayTeam.crest %>" alt="<%= incontri.awayTeam.name %>" class="team-logo-small" style="width: 28px; height: 28px; object-fit: contain;">
                            <span class="fw-semibold ms-2 text-truncate d-none d-sm-inline"><%= incontri.awayTeam.name %></span>
                        </div>

                        <!-- ESITO / STATO -->
                        <div class="col-12 col-md-2 text-center text-md-end mt-2 mt-md-0">
                            <% if (incontri.score.winner === "HOME_TEAM") { %>
                                <span class="badge rounded-pill bg-success-subtle text-success w-100 py-2">Vittoria Casa</span>
                            <% } else if (incontri.score.winner === "AWAY_TEAM") { %>
                                <span class="badge rounded-pill bg-info-subtle text-info w-100 py-2">Vittoria Fuori</span>
                            <% } else if (incontri.score.winner === "DRAW") { %>
                                <span class="badge rounded-pill bg-secondary-subtle text-secondary w-100 py-2">Pareggio</span>
                            <% } else { %>
                                <span class="badge rounded-pill bg-light text-muted border w-100 py-2">Da giocare</span>
                            <% } %>
                        </div>

                    </div>
                <% }); %>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>