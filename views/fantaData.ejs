<!-- ----------------------------------------------------------------- -->
<!-- PAGINA CON DATI GIOCATORI PER IL FANTA                            -->
<!--                            11.08.26                               -->
<!-- ----------------------------------------------------------------- -->

<%- include('partials/header.ejs') %>

    <div class="container py-5 my-3 my-md-4">
        <!-- Header e Info Data -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 mb-md-4 pb-2 border-bottom">
            <div>
                <h3 class="fw-bold mb-0 h4-sm">Listone Fantacalcio</h3>
                <p class="text-muted small mb-0">Fonte: FantaCalcioPedia &bull; Aggiornato al <b>20/08/2026</b></p>
            </div>
        </div>

        <!-- Filtri Client-Side -->
        <div class="row g-2 g-md-3 mb-3 mb-md-4">
            <div class="col-lg-4 col-md-6">
                <div class="input-group input-group-sm-custom">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0"
                        placeholder="Cerca giocatore...">
                </div>
            </div>
            <div class="col-lg-2 col-6 col-md-6">
                <select id="roleFilter" class="form-select">
                    <option value="">Tutti i Ruoli</option>
                    <% ruoli.forEach(ruolo=> { %>
                        <option value="<%= ruolo %>">
                            <%= ruolo %>
                        </option>
                        <% }) %>
                </select>
            </div>
            <div class="col-lg-3 col-6 col-md-6">
                <select id="teamFilter" class="form-select">
                    <option value="">Tutte le Squadre</option>
                    <% squadre.forEach(squadra=> { %>
                        <option value="<%= squadra %>">
                            <%= squadra %>
                        </option>
                        <% }) %>
                </select>
            </div>
            <div class="col-lg-3 col-12 col-md-6">
                <select id="trendFilter" class="form-select">
                    <option value="">Tutti i Trend</option>
                    <% trend.forEach(trendValue=> { %>
                        <option value="<%= trendValue %>">
                            <%= trendValue %>
                        </option>
                        <% }) %>
                </select>
            </div>
        </div>

        <!-- Tabella (Niente scroll orizzontale su mobile) -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="table-responsive-sm">
                <table class="table table-hover align-middle mb-0 table-custom" id="playersTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-2 ps-md-4">Ruolo</th>
                            <th>Nome</th>
                            <th>Squadra</th>
                            <th class="text-center">Punteggio</th>
                            <!-- Nasconde FM 25/26 da schermi < 768px -->
                            <th class="text-center d-none d-md-table-cell">FM 25/26</th>
                            <th class="text-center pe-2 pe-md-4">Conv.</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% giocatori.forEach(g=> {
                            let fmVal = g['Fantamedia 2025-2026'];
                            if (!fmVal && g.Fantamedie && g.Fantamedie['2025-2026']) {
                            fmVal = g.Fantamedie['2025-2026'];
                            }
                            %>
                            <tr data-id="<%= g.id %>" data-nome="<%= g.Nome %>" data-ruolo="<%= g.Ruolo %>"
                                data-squadra="<%= g.Squadra %>" data-trend="<%= g.Trend %>" class="player-row">

                                <!-- Ruolo -->
                                <td class="ps-2 ps-md-4">
                                    <span class="badge rounded-pill badge-role-<%= g.Ruolo %> px-2 py-1 fs-7">
                                        <%= g.Ruolo %>
                                    </span>
                                </td>

                                <!-- Nome Rimpicciolito -->
                                <td>
                                    <div class="fw-bold text-dark player-name d-flex align-items-center gap-1">
                                        <%= g.Nome %>
                                            <% if (g.Trend==='UP' ) { %>
                                                <i class="bi bi-arrow-up-short text-success fs-6" title="Trend UP"></i>
                                                <% } else if (g.Trend==='DOWN' ) { %>
                                                    <i class="bi bi-arrow-down-short text-danger fs-6"
                                                        title="Trend DOWN"></i>
                                                    <% } %>
                                    </div>
                                </td>

                                <!-- Squadra -->
                                <td class="text-secondary small">
                                    <%= g.Squadra %>
                                </td>

                                <!-- Punteggio -->
                                <td class="text-center fw-semibold text-dark small">
                                    <%= g.Punteggio || '-' %>
                                </td>

                                <!-- FM 25/26 (Visibile solo da Medium screens in su) -->
                                <td class="text-center d-none d-md-table-cell">
                                    <% if (fmVal && !isNaN(fmVal)) { %>
                                        <span
                                            class="badge <%= fmVal >= 6.5 ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-light text-dark' %> px-2 py-1">
                                            <%= Number(fmVal).toFixed(2) %>
                                        </span>
                                        <% } else { %>
                                            <span class="text-muted small">N/D</span>
                                            <% } %>
                                </td>

                                <!-- Convenienza -->
                                <td class="text-center pe-2 pe-md-4">
                                    <span class="fw-bold text-primary small">
                                        <%= g.Convenienza ? Number(g.Convenienza).toFixed(1) : '-' %>
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <form id="hiddenForm" action="/statgiocatore" method="POST" style="display:none;">
        <input type="hidden" name="idPlayer" id="idPlayer">
        <input type="hidden" name="namePlayer" id="namePlayer">
    </form>

    <script>
        const searchInput = document.getElementById('searchInput');
        const roleFilter = document.getElementById('roleFilter');
        const teamFilter = document.getElementById('teamFilter');
        const trendFilter = document.getElementById('trendFilter');
        const rows = document.querySelectorAll('#playersTable tbody tr');


        // Gestione Click sulle righe in modo sicuro e senza problemi di string escaping
        rows.forEach(row => {
            row.addEventListener('click', () => {
                const id = row.getAttribute('data-id');
                const nome = row.getAttribute('data-nome');

                document.getElementById('idPlayer').value = id;
                document.getElementById('namePlayer').value = nome;
                document.getElementById('hiddenForm').submit();
            });
        });

        function filterTable() {
            const search = searchInput.value.toLowerCase();
            const role = roleFilter.value;
            const team = teamFilter.value;
            const trend = trendFilter.value;

            rows.forEach(row => {
                const name = row.children[1].textContent.toLowerCase();
                const rowRole = row.getAttribute('data-ruolo');
                const rowTeam = row.getAttribute('data-squadra');
                const rowTrend = row.getAttribute('data-trend');

                const matchesSearch = name.includes(search);
                const matchesRole = !role || rowRole === role;
                const matchesTeam = !team || rowTeam === team;
                const matchesTrend = !trend || rowTrend === trend;

                row.style.display = (matchesSearch && matchesRole && matchesTeam && matchesTrend) ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', filterTable);
        roleFilter.addEventListener('change', filterTable);
        teamFilter.addEventListener('change', filterTable);
        trendFilter.addEventListener('change', filterTable);

    </script>
    <%- include('partials/footer.ejs') %>